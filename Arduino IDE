#include <TinyGPS++.h>
#include <HardwareSerial.h>
#include <Wire.h>
#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>

// ----------- Objects -----------
TinyGPSPlus gps;
HardwareSerial sim800(2); // GSM
HardwareSerial gpsSerial(1); // GPS
Adafruit_MPU6050 mpu;

// ----------- Pins -----------
#define BUTTON_PIN 12

// ----------- Variables -----------
String phoneNumber = "+919999999999";
bool sosTriggered = false;

// ----------- Setup -----------
void setup() {
  Serial.begin(115200);

  pinMode(BUTTON_PIN, INPUT_PULLUP);

  // GSM
  sim800.begin(9600, SERIAL_8N1, 16, 17);

  // GPS
  gpsSerial.begin(9600, SERIAL_8N1, 4, 5);

  // MPU6050
  if (!mpu.begin()) {
    Serial.println("MPU6050 not found!");
    while (1);
  }

  Serial.println("System Ready...");
}

// ----------- Loop -----------
void loop() {
  readGPS();

  // Panic Button
  if (digitalRead(BUTTON_PIN) == LOW) {
    Serial.println("SOS Button Pressed!");
    triggerSOS();
    delay(5000);
  }

  // Fall Detection
  sensors_event_t a, g, temp;
  mpu.getEvent(&a, &g, &temp);

  float acceleration = sqrt(a.acceleration.x * a.acceleration.x +
                            a.acceleration.y * a.acceleration.y +
                            a.acceleration.z * a.acceleration.z);

  if (acceleration > 25) { // threshold for fall
    Serial.println("Fall Detected!");
    triggerSOS();
    delay(5000);
  }
}

// ----------- GPS Function -----------
void readGPS() {
  while (gpsSerial.available()) {
    gps.encode(gpsSerial.read());
  }
}

// ----------- SOS Function -----------
void triggerSOS() {
  if (!gps.location.isValid()) {
    Serial.println("No GPS Signal!");
    return;
  }

  String latitude = String(gps.location.lat(), 6);
  String longitude = String(gps.location.lng(), 6);

  String message = "🚨 SOS ALERT!\n";
  message += "Help needed!\n";
  message += "Location: https://maps.google.com/?q=";
  message += latitude + "," + longitude;

  sendSMS(message);
  makeCall();
}

// ----------- Send SMS -----------
void sendSMS(String msg) {
  Serial.println("Sending SMS...");

  sim800.println("AT+CMGF=1");
  delay(1000);

  sim800.print("AT+CMGS=\"");
  sim800.print(phoneNumber);
  sim800.println("\"");
  delay(1000);

  sim800.print(msg);
  delay(1000);

  sim800.write(26); // CTRL+Z
  delay(3000);

  Serial.println("SMS Sent!");
}

// ----------- Call Function -----------
void makeCall() {
  Serial.println("Calling...");

  sim800.print("ATD");
  sim800.print(phoneNumber);
  sim800.println(";");
  delay(15000);

  sim800.println("ATH"); // Hang up
}
